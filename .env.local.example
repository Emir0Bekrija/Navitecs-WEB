# ─────────────────────────────────────────────────────────────
# NAVITECS Admin Panel – Required Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.

# Admin password — used to log into the /admin panel
ADMIN_PASSWORD=change_me_to_a_strong_password

# Secret used to sign session tokens — must be a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_hex_string
